[Unit]
Description=CutiePi Shell
# systemd-udev-settle ensures device coldplug (including DRM/KMS device nodes under
# /dev/dri) has finished before the first launch attempt - observed crash-looping on
# Test_Coachwhip_HIL HIL runs with "drmModeGetResources failed (Operation not supported)" /
# "Cannot create window: no screens available" (SIGABRT), NRestarts climbing during steady-state
# uptime with no reboot in between. The launcher script's own wait-for-display loop is the
# primary mitigation; this ordering closes the same race at the systemd level too.
After=systemd-user-sessions.service connman.service dbus.service upspack-monitor.service systemd-udev-settle.service
Wants=connman.service dbus.service upspack-monitor.service systemd-udev-settle.service

[Service]
# Runs unprivileged (not root) so QtWebEngine's Chromium sandbox can actually activate -
# Chromium's zygote refuses to fork sandboxed renderers as root (crbug.com/638180):
# confirmed on real hardware, cutiepi-shell exited with status 1/FAILURE ("Running as root
# without --no-sandbox is not supported") the first time a WebEngineView needed to render,
# i.e. as soon as someone typed a URL/search and hit enter. video/render/audio group
# membership (see brumation.sample) covers /dev/dri and /dev/snd device access.
User=cutiepi
WorkingDirectory=/home/cutiepi
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_KMS_CONFIG=/opt/cutiepi-shell/kms.conf
# No hardcoded XDG_RUNTIME_DIR/DBUS_SESSION_BUS_ADDRESS here (both used to say uid 0,
# root's uid, which no longer matches the running user) - the launcher script computes
# these from $(id -u) itself and creates the directory.
# shell.qml polls /run/battery/state.json via XMLHttpRequest every 30s; QML's XHR blocks
# local file:// reads by default, so battery status has never actually worked
# ("XMLHttpRequest: Using GET on a local file is disabled by default" every 30s in the
# journal, confirmed on real hardware).
Environment=QML_XHR_ALLOW_FILE_READ=1
# rfkill/cpufreq-set need root (raw rfkill state, and cpufreq's sysfs governor file is
# root-only) - the '+' prefix runs just this line as root regardless of User= above, once
# at boot, before dropping to the unprivileged user for the actual application.
ExecStartPre=+/bin/sh -c 'rfkill unblock all; cpufreq-set -g ondemand || true'
ExecStart=/opt/cutiepi-shell/cutiepi-shell
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
