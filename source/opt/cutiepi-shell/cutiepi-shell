#!/bin/bash

set -u

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/tmp/user/$(id -u)"
fi
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}" 2>/dev/null || true

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

if [ -z "${QT_IM_MODULE:-}" ]; then
    export QT_IM_MODULE=qtvirtualkeyboard
fi

#export QT_VIRTUALKEYBOARD_LAYOUT_PATH=/opt/cutiepi-shell/layouts/
#export QT_QPA_EGLFS_KMS_CONFIG=/opt/cutiepi-shell/kms.conf

if [ ! "$(systemctl is-active connman 2>/dev/null)" == "active" ]; then
    service connman start 2>/dev/null || true
fi

rfkill unblock all 2>/dev/null || true

if command -v cpufreq-set >/dev/null 2>&1; then
    cpufreq-set -g ondemand 2>/dev/null || true
fi

exec /opt/cutiepi-shell/shell